<section class="hotspot-section page_width">
  {% if section.settings.section_title != blank %}
    <h2 class="category-grid-title">{{ section.settings.section_title }}</h2>
  {% endif %}

  {% if section.settings.bg_image != blank %}
    <div class="hotspot-wrapper">
      <img
        src="{{ section.settings.bg_image | image_url: width: 2000 }}"
        alt="Hotspot Banner"
        class="hotspot-bg"
      >

      {% for block in section.blocks %}
        {% assign product = block.settings.product %}

        <div
          class="hotspot-pin"
          style="top: {{ block.settings.pos_y }}%; left: {{ block.settings.pos_x }}%;"
          {{ block.shopify_attributes }}
        >
          <span
            class="pin-dot"
            style="
              background: {{ block.settings.pin_color }};
              border-color: {{ block.settings.pin_border }};
              box-shadow: 0 0 8px {{ block.settings.pin_glow }};
            "
          ></span>

          <div
            class="tooltip-box"
            style="
              background: {{ block.settings.tooltip_bg }};
              color: {{ block.settings.tooltip_text }};
            "
          >
            {% if block.settings.tooltip_title != blank %}
              <h4 class="tooltip-title">{{ block.settings.tooltip_title }}</h4>
            {% endif %}

            {% if product %}
              <a href="{{ product.url }}" class="tooltip-product">
                <img
                  src="{{ product.featured_image | image_url: width: 200 }}"
                  alt="{{ product.title }}"
                >
                <div>
                  <p class="tooltip-prod-title">{{ product.title }}</p>
                  <p class="tooltip-prod-price">{{ product.price | money }}</p>
                </div>
              </a>
            {% endif %}

            {% if block.settings.tooltip_description != blank %}
              <p class="tooltip-desc">{{ block.settings.tooltip_description }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</section>

<style>

  .hotspot-pin {
    position: absolute;
    transform: translate(-50%, -50%);
    cursor: pointer;
    z-index: 5;
    {% comment %} background:red; {% endcomment %}
    width: 18px;
    height:18px;
  }

  .pin-dot {
    width: 100%;
    height: 100%;
    display:block;
    border-radius: 50%;
    border-width: 3px;
    border-style: solid;
    box-sizing: border-box; /* FIXED - makes perfect circle */
    animation: pulse 1.6s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(1); opacity: 1; }
    100% { transform: scale(1.35); opacity: 0.4; }
  }

  .tooltip-box {
    position: absolute;
    top: -10px;
    left: 30px;
    width: 220px;
    padding: 12px;
    border-radius: 10px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: 0.25s ease;
    z-index: 10;
  }

  .hotspot-pin:hover .tooltip-box {
    opacity: 1;
    visibility: visible;
    transform: translateY(0px);
  }

  .tooltip-product {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 10px 0;
    text-decoration: none;
    color: inherit;
  }

  .tooltip-product img {
    width: 50px;
    height: 50px;
    border-radius: 6px;
  }

  .tooltip-title {
    font-size: 15px;
    font-weight: 600;
  }
  .tooltip-desc,
  .tooltip-prod-title,
  .tooltip-prod-price {
    font-size: 13px;
  }

  /* Mobile click/tap logic */
  @media (max-width: 768px) {
    .tooltip-box {
      left: 50%;
      transform: translate(-50%, 10px);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const pins = document.querySelectorAll('.hotspot-pin');

    pins.forEach((pin) => {
      pin.addEventListener('click', function (e) {
        if (window.innerWidth < 769) {
          e.stopPropagation();

          const tooltip = pin.querySelector('.tooltip-box');
          const open = tooltip.classList.toggle('active');

          document.querySelectorAll('.tooltip-box.active').forEach((box) => {
            if (box !== tooltip) box.classList.remove('active');
          });

          if (open) {
            tooltip.style.opacity = '1';
            tooltip.style.visibility = 'visible';
            tooltip.style.transform = 'translateY(0)';
          } else {
            tooltip.style.opacity = '0';
            tooltip.style.visibility = 'hidden';
            tooltip.style.transform = 'translateY(10px)';
          }
        }
      });
    });

    document.body.addEventListener('click', () => {
      document.querySelectorAll('.tooltip-box.active').forEach((box) => {
        box.classList.remove('active');
        box.style.opacity = '0';
        box.style.visibility = 'hidden';
        box.style.transform = 'translateY(10px)';
      });
    });
  });
</script>

{% schema %}
{
  "name": "Product Hotspots Banner",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Shop by Category"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot Pin",
      "settings": [
        {
          "type": "range",
          "id": "pos_x",
          "label": "Position X (Left)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        },
        {
          "type": "range",
          "id": "pos_y",
          "label": "Position Y (Top)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        },
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "text",
          "id": "tooltip_title",
          "label": "Tooltip Title"
        },
        {
          "type": "textarea",
          "id": "tooltip_description",
          "label": "Tooltip Description"
        },

        {
          "type": "header",
          "content": "Pin Colors"
        },
        {
          "type": "color",
          "id": "pin_color",
          "label": "Pin Color",
          "default": "#ff3b30"
        },
        {
          "type": "color",
          "id": "pin_border",
          "label": "Pin Border Color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "pin_glow",
          "label": "Pin Glow / Pulse Color",
          "default": "rgba(255, 59, 48, 0.5)"
        },

        {
          "type": "header",
          "content": "Tooltip Colors"
        },
        {
          "type": "color",
          "id": "tooltip_bg",
          "label": "Tooltip Background",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "tooltip_text",
          "label": "Tooltip Text Color",
          "default": "#000000"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Product Hotspots Banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}
