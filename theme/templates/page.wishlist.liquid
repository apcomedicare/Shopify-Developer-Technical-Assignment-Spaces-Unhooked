{% layout 'page' %}

<div class="wishlish_page page_width">
    <h1 style="text-align:center;">Your Wishlist</h1>
<div class="wishlist-products grid_container"></div>
</div>


<style>
  .wishlist-products .card_item {
    border: 1px solid #eee;
    padding: 15px;
    margin-bottom: 15px;
    display: flex;
    gap: 15px;
    align-items: center;
  }
  .wishlist-products .item_images-content img {
    width: 120px;
    height: auto;
  }
  .wishlist-products .item-content h3 {
    margin: 0 0 10px;
    font-size: 1rem;
  }
  .wishlist-products .price {
    font-weight: bold;
    margin-bottom: 10px;
  }
  .wishlist-products .remove-wishlist-btn {
    background: red;
    color: white;
    border: none;
    padding: 5px 10px;
    cursor: pointer;
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const WISHLIST_KEY = 'wishlist_items';
  const wishlistContainer = document.querySelector('.wishlist-products');

  const getWishlist = () => JSON.parse(localStorage.getItem(WISHLIST_KEY)) || [];
  const saveWishlist = (wishlist) => localStorage.setItem(WISHLIST_KEY, JSON.stringify(wishlist));

  const renderWishlist = async () => {
    wishlistContainer.innerHTML = '';
    const wishlist = getWishlist();

    if (wishlist.length === 0) {
      wishlistContainer.innerHTML = '<p>Your wishlist is empty.</p>';
      return;
    }

    try {
      // Fetch all products
      const res = await fetch('/products.json');
      const data = await res.json();

      if (!data.products || data.products.length === 0) {
        wishlistContainer.innerHTML = '<p>No products found.</p>';
        return;
      }

      // Filter products that are in the wishlist
      const wishlistProducts = data.products.filter(p => wishlist.includes(p.id.toString()));

      wishlistProducts.forEach(product => {
        const productHTML = `
          <div class="card_item">
            <div class="item_images-content">
              <a href="/products/${product.handle}">
                <img src="${product.images[0]?.src || ''}" alt="${product.title}">
              </a>
            </div>
            <div class="item-content">
              <a href="/products/${product.handle}">
                <h3>${product.title}</h3>
              </a>
              <div class="price">₹${Number(product.variants[0].price).toLocaleString()}</div>
              <button class="remove-wishlist-btn" data-id="${product.id}">Remove</button>
            </div>
          </div>
        `;
        wishlistContainer.insertAdjacentHTML('beforeend', productHTML);
      });

      // Remove button click
      wishlistContainer.querySelectorAll('.remove-wishlist-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          let wishlist = getWishlist();
          const id = btn.dataset.id;
          wishlist = wishlist.filter(pid => pid != id);
          saveWishlist(wishlist);
          renderWishlist(); // re-render after removing
        });
      });

    } catch (error) {
      console.error('Error fetching wishlist products:', error);
      wishlistContainer.innerHTML = '<p>Failed to load wishlist.</p>';
    }
  };

  renderWishlist();
});
</script>
